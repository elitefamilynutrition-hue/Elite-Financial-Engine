# Elite Capital Engine — environment template (no secret values)
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Gemini
GEMINI_API_KEY=

# Token encryption (64-char hex = 32 bytes)
ENCRYPTION_KEY=

# Auth / access
NEXT_PUBLIC_INVITE_CODE=
ADMIN_EMAILS=

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional until go-live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Sentry (Week 3 Day 4)
# SENTRY_DSN=
