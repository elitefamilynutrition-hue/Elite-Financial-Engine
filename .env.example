# Elite Capital Engine — environment template (no secret values)
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Gemini
GEMINI_API_KEY=

# Token encryption (64-char hex = 32 bytes)
ENCRYPTION_KEY=

# Auth / access
NEXT_PUBLIC_INVITE_CODE=
ADMIN_EMAILS=

# Operator Lab (fail-closed unless true). Requires ADMIN_EMAILS membership.
ENABLE_LAB=false
# Optional: require AAL2 for /lab when MFA factors exist (see TESTING.md)
ENFORCE_MFA_FOR_LAB=false
# RAG tax lab UI + API (also requires Lab access)
ENABLE_RAG_TAX=false
# Affiliate CTA flag — keep false until counsel disclosure copy exists
ENABLE_AFFILIATE_CTA=false

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public contact mailto (optional; falls back to operator email in /contact)
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe (optional until go-live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Sentry (Week 3 Day 4) — same DSN value in both; omit to disable
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Cron (Phase 6.3) — Authorization: Bearer <CRON_SECRET>
# Cron only fires on Vercel deploy; local stays manual Sync + Stamp Snapshot.
CRON_SECRET=
